generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  password      String
  phone         String?
  createdAt     DateTime       @default(now())
  role          String         @default("customer")
  invoices      Invoice[]
  subscriptions Subscription[]
  fac_clientes  fac_clientes[]
}

model Plan {
  id            String         @id @default(cuid())
  name          String
  description   String
  price         Float
  interval      String
  active        Boolean        @default(true)
  features      String[]
  createdAt     DateTime       @default(now())
  productId     String?
  Product       Product?       @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subscriptions Subscription[]
}

model Subscription {
  id                 String        @id @default(cuid())
  userId             String
  planId             String
  status             String        @default("pending")
  startDate          DateTime?
  endDate            DateTime?
  servixSlug         String?       @unique
  servixRestaurantId String?
  redsysOrderId      String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  billingData        String?
  type               String        @default("PRO_MONTHLY")
  productId          String?
  invoices           Invoice[]
  provisioning       Provisioning?
  plan               Plan          @relation(fields: [planId], references: [id])
  product            Product?      @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user               User          @relation(fields: [userId], references: [id])
}

model Invoice {
  id             String       @id @default(cuid())
  userId         String
  subscriptionId String
  amount         Float
  status         String       @default("pending")
  redsysOrderId  String?      @unique
  paidAt         DateTime?
  createdAt      DateTime     @default(now())
  provider       String       @default("redsys")
  providerRef    String?
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  user           User         @relation(fields: [userId], references: [id])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model RedsysConfig {
  id           String  @id @default(cuid())
  merchantCode String
  secretKey    String
  terminal     String
  currency     String  @default("978")
  environment  String  @default("test")
  enabled      Boolean @default(true)
}

model Product {
  id            String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  slug          String         @unique
  name          String
  dbUrlEnvVar   String
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now()) @db.Timestamp(6)
  Plan          Plan[]
  subscriptions Subscription[]
}

model Provisioning {
  id             String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  subscriptionId String       @unique
  externalId     String?
  slug           String?
  status         String       @default("pending")
  meta           Json?
  createdAt      DateTime     @default(now()) @db.Timestamp(6)
  updatedAt      DateTime     @default(now()) @db.Timestamp(6)
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model StripeConfig {
  id             String  @id @default(dbgenerated("(gen_random_uuid())::text"))
  publishableKey String  @default("")
  secretKey      String  @default("")
  webhookSecret  String  @default("")
  environment    String  @default("test")
  enabled        Boolean @default(false)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model fac_ajustes {
  id                         Int      @id @default(1)
  emisor_nombre              String   @default("")
  nombre_comercial           String   @default("")
  nif                        String   @default("")
  direccion                  String   @default("")
  cp                         String   @default("")
  municipio                  String   @default("")
  provincia                  String   @default("")
  pais                       String   @default("ES") @db.Char(2)
  email                      String   @default("")
  telefono                   String   @default("")
  iban                       String   @default("")
  iae                        String   @default("763")
  iva_defecto                Decimal  @default(21) @db.Decimal(5, 2)
  retencion_defecto          Decimal  @default(7) @db.Decimal(5, 2)
  retencion_en_cobros_online Boolean  @default(false)
  limite_simplificada        Decimal  @default(400) @db.Decimal(12, 2)
  dias_vencimiento           Int      @default(15)
  recordatorios_activos      Boolean  @default(true)
  recordatorio_cada_dias     Int      @default(7)
  recordatorio_max           Int      @default(3)
  texto_pie                  String   @default("")
  logo_path                  String?
  verifactu_activo           Boolean  @default(false)
  fecha_inicio_actividad     DateTime @default(dbgenerated("'2026-10-01'::date")) @db.Date
  updated_at                 DateTime @default(now()) @db.Timestamptz(6)
  qr_no_verifactu            Boolean  @default(false)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model fac_clientes {
  id               String            @id @default(dbgenerated("(gen_random_uuid())::text"))
  tipo             String
  razon_social     String
  nombre_comercial String?
  nif              String?
  tipo_id          String            @default("01")
  pais             String            @default("ES") @db.Char(2)
  direccion        String?
  cp               String?
  municipio        String?
  provincia        String?
  email            String?
  telefono         String?
  aplica_retencion Boolean           @default(false)
  user_id          String?
  notas            String?
  activo           Boolean           @default(true)
  created_at       DateTime          @default(now()) @db.Timestamptz(6)
  updated_at       DateTime          @default(now()) @db.Timestamptz(6)
  User             User?             @relation(fields: [user_id], references: [id], onUpdate: NoAction)
  fac_facturas     fac_facturas[]
  fac_recurrentes  fac_recurrentes[]

  @@index([user_id], map: "fac_clientes_user_idx")
}

model fac_conceptos {
  id              String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  descripcion     String
  precio_unitario Decimal  @default(0) @db.Decimal(14, 4)
  tipo_iva        Decimal  @default(21) @db.Decimal(5, 2)
  activo          Boolean  @default(true)
  usos            Int      @default(0)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
}

model fac_eventos {
  id         BigInt   @id @default(autoincrement())
  created_at DateTime @default(now()) @db.Timestamptz(6)
  usuario_id String?
  usuario    String?
  accion     String
  entidad    String
  entidad_id String?
  ip         String?
  payload    Json?

  @@index([entidad, entidad_id], map: "fac_eventos_entidad_idx")
  @@index([created_at], map: "fac_eventos_fecha_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model fac_facturas {
  id                      String                    @id @default(dbgenerated("(gen_random_uuid())::text"))
  serie_codigo            String                    @db.Char(1)
  serie_id                String?
  numero                  Int?
  num_serie_factura       String?
  tipo_factura            String
  fecha_expedicion        DateTime?                 @db.Date
  fecha_operacion         DateTime?                 @db.Date
  fecha_vencimiento       DateTime?                 @db.Date
  descripcion_operacion   String                    @default("")
  cliente_id              String?
  emisor_snapshot         Json?
  cliente_snapshot        Json?
  base_imponible          Decimal                   @default(0) @db.Decimal(12, 2)
  cuota_iva               Decimal                   @default(0) @db.Decimal(12, 2)
  importe_total           Decimal                   @default(0) @db.Decimal(12, 2)
  tipo_retencion          Decimal                   @default(0) @db.Decimal(5, 2)
  cuota_retencion         Decimal                   @default(0) @db.Decimal(12, 2)
  liquido_a_cobrar        Decimal                   @default(0) @db.Decimal(12, 2)
  estado                  String                    @default("borrador")
  metodo_pago             String?
  fecha_pago              DateTime?                 @db.Date
  origen                  String                    @default("manual")
  pago_ref                String?
  invoice_id              String?
  recurrente_id           String?
  bloqueo_motivo          String?
  rectificada_id          String?
  tipo_rectificacion      String?                   @db.Char(1)
  motivo_rectificacion    String?
  base_rectificada        Decimal?                  @db.Decimal(12, 2)
  cuota_rectificada       Decimal?                  @db.Decimal(12, 2)
  modo_verifactu          Boolean                   @default(false)
  notas                   String?
  pdf_path                String?
  entregada_at            DateTime?                 @db.Timestamptz(6)
  entregada_via           String?
  recordatorios_enviados  Int                       @default(0)
  ultimo_recordatorio_at  DateTime?                 @db.Timestamptz(6)
  emitida_at              DateTime?                 @db.Timestamptz(6)
  created_by              String?
  created_at              DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at              DateTime                  @default(now()) @db.Timestamptz(6)
  fac_clientes            fac_clientes?             @relation(fields: [cliente_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  fac_facturas            fac_facturas?             @relation("fac_facturasTofac_facturas", fields: [rectificada_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  other_fac_facturas      fac_facturas[]            @relation("fac_facturasTofac_facturas")
  fac_recurrentes         fac_recurrentes?          @relation(fields: [recurrente_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  fac_series              fac_series?               @relation(fields: [serie_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  fac_lineas              fac_lineas[]
  fac_registros_verifactu fac_registros_verifactu[]

  @@index([cliente_id], map: "fac_facturas_cliente_idx")
  @@index([estado])
  @@index([fecha_expedicion], map: "fac_facturas_fecha_idx")
  @@index([rectificada_id], map: "fac_facturas_rectif_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model fac_gastos {
  id              String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  proveedor       String
  proveedor_nif   String?
  proveedor_pais  String   @default("ES") @db.Char(2)
  numero          String?
  fecha           DateTime @db.Date
  fecha_registro  DateTime @default(dbgenerated("CURRENT_DATE")) @db.Date
  concepto        String?
  categoria       String   @default("otros")
  base_imponible  Decimal  @default(0) @db.Decimal(12, 2)
  tipo_iva        Decimal  @default(21) @db.Decimal(5, 2)
  cuota_iva       Decimal  @default(0) @db.Decimal(12, 2)
  tipo_retencion  Decimal  @default(0) @db.Decimal(5, 2)
  cuota_retencion Decimal  @default(0) @db.Decimal(12, 2)
  total           Decimal  @default(0) @db.Decimal(12, 2)
  deducible_pct   Decimal  @default(100) @db.Decimal(5, 2)
  iva_deducible   Boolean  @default(true)
  adjunto_path    String?
  adjunto_mime    String?
  notas           String?
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @db.Timestamptz(6)

  @@index([fecha])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
