generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  password      String
  phone         String?
  createdAt     DateTime       @default(now())
  role          String         @default("customer")
  invoices      Invoice[]
  subscriptions Subscription[]
}

model Plan {
  id            String         @id @default(cuid())
  name          String
  description   String
  price         Float
  interval      String
  active        Boolean        @default(true)
  features      String[]
  createdAt     DateTime       @default(now())
  productId     String?
  Product       Product?       @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subscriptions Subscription[]
}

model Subscription {
  id                 String        @id @default(cuid())
  userId             String
  planId             String
  status             String        @default("pending")
  startDate          DateTime?
  endDate            DateTime?
  servixSlug         String?       @unique
  servixRestaurantId String?
  redsysOrderId      String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  billingData        String?
  type               String        @default("PRO_MONTHLY")
  productId          String?
  invoices           Invoice[]
  provisioning       Provisioning?
  plan               Plan          @relation(fields: [planId], references: [id])
  product            Product?      @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user               User          @relation(fields: [userId], references: [id])
}

model Invoice {
  id             String       @id @default(cuid())
  userId         String
  subscriptionId String
  amount         Float
  status         String       @default("pending")
  redsysOrderId  String?      @unique
  paidAt         DateTime?
  createdAt      DateTime     @default(now())
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  user           User         @relation(fields: [userId], references: [id])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model RedsysConfig {
  id           String @id @default(cuid())
  merchantCode String
  secretKey    String
  terminal     String
  currency     String @default("978")
  environment  String @default("test")
}

model Product {
  id            String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  slug          String         @unique
  name          String
  dbUrlEnvVar   String
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now()) @db.Timestamp(6)
  Plan          Plan[]
  subscriptions Subscription[]
}

model Provisioning {
  id             String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  subscriptionId String       @unique
  externalId     String?
  slug           String?
  status         String       @default("pending")
  meta           Json?
  createdAt      DateTime     @default(now()) @db.Timestamp(6)
  updatedAt      DateTime     @default(now()) @db.Timestamp(6)
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}
