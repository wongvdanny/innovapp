  orden            Int          @default(0)
  descripcion      String
  cantidad         Decimal      @default(1) @db.Decimal(14, 4)
  precio_unitario  Decimal      @default(0) @db.Decimal(14, 4)
  descuento_pct    Decimal      @default(0) @db.Decimal(5, 2)
  tipo_iva         Decimal      @default(21) @db.Decimal(5, 2)
  clave_regimen    String       @default("01")
  calificacion     String       @default("S1")
  operacion_exenta String?
  base             Decimal      @default(0) @db.Decimal(12, 2)
  cuota            Decimal      @default(0) @db.Decimal(12, 2)
  fac_facturas     fac_facturas @relation(fields: [factura_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([factura_id, orden], map: "fac_lineas_factura_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
