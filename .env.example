# Blog automático con IA (scripts/generate-blog-post.mjs)
# API key de Anthropic (mismo patrón que /var/www/agentes).
ANTHROPIC_API_KEY=

# Envío de sitemap a Google Search Console (scripts/submit-sitemap.mjs)
# Ruta ABSOLUTA en el servidor al JSON de la cuenta de servicio de Google
# (nunca commitear el JSON en sí -- ver secrets/ en .gitignore).
GSC_SERVICE_ACCOUNT_PATH=
