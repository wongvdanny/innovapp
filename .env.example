# Blog automático con IA (scripts/generate-blog-post.mjs)
# API key de Anthropic (mismo patrón que /var/www/agentes).
ANTHROPIC_API_KEY=

# Envío de sitemap a Google Search Console (scripts/submit-sitemap.mjs)
# Ruta ABSOLUTA en el servidor al JSON de la cuenta de servicio de Google
# (nunca commitear el JSON en sí -- ver secrets/ en .gitignore).
GSC_SERVICE_ACCOUNT_PATH=

# reCAPTCHA v2 "Casilla de verificación" del formulario de contacto (pages/contacto.tsx).
# Claves en https://www.google.com/recaptcha/admin/create -- tipo "reCAPTCHA v2 /
# Casilla de verificación 'No soy un robot'", dominio innovapp.es (añade también
# localhost si vas a probarlo en local). Mientras RECAPTCHA_SECRET_KEY esté vacía, el
# formulario sigue funcionando sin captcha (solo honeypot + rate limit) -- no falla el
# build ni el envío por no tenerla configurada.
# Site key: pública, va al HTML del cliente.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Secret key: NUNCA pública, solo se usa en pages/api/contacto.ts.
RECAPTCHA_SECRET_KEY=
